# SUPERADMIN account seeded on startup (see SuperAdminSeeder).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT signing secret (required) -- use a long random string.
JWT_SECRET=change-me

# Database (defaults in application-dev.yml cover local host Postgres).
DB_URL=host.docker.internal
DB_NAME=blood_buddy
DB_USERNAME=postgres
DB_PASSWORD=change-me

# SMTP / mail (host+port default to Gmail; username+password required).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=change-me

# AWS credentials (shared by S3 and End User Messaging SMS).
AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me
AWS_REGION=ap-south-1